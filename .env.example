# Omniframes YouTube Niche-Research Harness — environment variables
# Copy to .env and fill in real values. Never commit .env.

# === PostgreSQL (shared, managed instance) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omniframes_harness
POSTGRES_USER=omniframes
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=require

# === YouTube Data API v3 ===
YOUTUBE_API_KEY=your_youtube_api_key_here

# === Bright Data ===
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_DATASET_ID=your_dataset_id_here

# === DeepSeek (OpenAI-compatible endpoint) ===
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === Kimi / Moonshot (OpenAI-compatible endpoint) ===
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.ai/v1

# === Harness config ===
BUDGET_LIMIT_USD=10.00
SATURATION_NOVELTY_THRESHOLD=0.05
SATURATION_CONSECUTIVE_WINDOW=3
LOG_LEVEL=INFO