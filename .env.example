# YouTube Niche-Research Harness — environment variables
# Copy to .env and fill in real values. Never commit .env.

# === PostgreSQL (shared, managed instance) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=niche_harness
POSTGRES_USER=niche_harness
POSTGRES_PASSWORD=change_me
POSTGRES_SSLMODE=require

# === YouTube Data API v3 ===
YOUTUBE_API_KEY=your_youtube_api_key_here

# === Bright Data ===
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
BRIGHTDATA_DATASET_ID=your_dataset_id_here

# === OpenRouter — routes both DeepSeek V4-Pro/Flash and Kimi K3/K2.6 ===
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default, uncomment to override

# === Harness config ===
BUDGET_LIMIT_USD=10.00
SATURATION_NOVELTY_THRESHOLD=0.05
SATURATION_CONSECUTIVE_WINDOW=3
LOG_LEVEL=INFO