# YouTube Niche-Research Harness — environment variables
# Copy to .env and fill in real values. Never commit .env.

# === PostgreSQL (shared, managed instance) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=niche_harness
POSTGRES_USER=niche_harness
POSTGRES_PASSWORD=admin
POSTGRES_SSLMODE=require

# === YouTube Data API v3 ===
YOUTUBE_API_KEY=your_youtube_api_key_here

# === Bright Data ===
BRIGHTDATA_API_KEY=your_brightdata_api_key_here
# The three collector IDs default to the real ones in src/config.py. Set these
# only to point at different collectors.
# BRIGHTDATA_CHANNELS_DATASET_ID=gd_lk538t2k2p1k3oos71
# BRIGHTDATA_VIDEOS_DATASET_ID=gd_lk56epmy2i5g7lzu0k
# BRIGHTDATA_COMMENTS_DATASET_ID=gd_lk9q0ew71spt1mxywf
# live | replay — replay serves recorded fixtures and spends nothing.
BRIGHTDATA_MODE=live

# === OpenRouter — routes both DeepSeek V4-Pro/Flash and Kimi K3/K2.6 ===
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default, uncomment to override

# === Harness config ===
# HARNESS_PROFILE drives every cost governor — see PROFILES in src/config.py.
#   smoke   — first live test. ~100 records, $1 ceiling, comment mining off.
#             Measured on the real rung-04 run: 95 records, $0.14.
#   bounded — real research run. $5 ceiling, 1,500-record ceiling.
#   full    — no caps. Do not use until a bounded run has completed cleanly.
HARNESS_PROFILE=smoke
SATURATION_NOVELTY_THRESHOLD=0.05
SATURATION_CONSECUTIVE_WINDOW=3
LOG_LEVEL=INFO

# Individual governors. Each overrides the profile GLOBALLY, for every run —
# which silently defeats the smoke ceiling. Prefer switching HARNESS_PROFILE.
# BUDGET_LIMIT_USD=1.00
# BRIGHTDATA_RECORD_BUDGET=150
# GRAPH_WALK_FRONTIER_PER_ROUND=5
# MAX_ROUNDS_PER_BRANCH=4

# === v2 adaptive depth ===
# cluster_branch is deterministic and cheap — it runs on every node saturation.
# MIN_CHANNELS_FOR_SPLIT=8      # smaller communities are noise
# MIN_CLUSTER_DISTINCTNESS=0.3  # intra/inter edge-weight ratio
# CLUSTER_SEED=42               # Louvain reproducibility — do not vary
# BRANCH_LINEAGE_BUDGET_ENABLED=true
